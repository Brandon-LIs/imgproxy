{
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, proxy-revalidate" }
      ]
    },
    {
      "source": "/((?!$).*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, HEAD, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "*" },
        { "key": "Access-Control-Max-Age", "value": "86400" },
        { "key": "Vary", "value": "Origin" },
        { "key": "Cache-Control", "value": "public, max-age=604800, s-maxage=2592000" }
      ]
    },
    {
      "source": "/npm/:path*",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, HEAD, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "*" },
        { "key": "Access-Control-Max-Age", "value": "86400" },
        { "key": "Vary", "value": "Origin" },
        { "key": "Cache-Control", "value": "public, max-age=604800, s-maxage=31536000, immutable" }
      ]
    },
    {
      "source": "/gh/:path*",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, HEAD, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "*" },
        { "key": "Access-Control-Max-Age", "value": "86400" },
        { "key": "Vary", "value": "Origin" },
        { "key": "Cache-Control", "value": "public, max-age=604800, s-maxage=31536000, immutable" }
      ]
    },
    {
      "source": "/wp/:path*",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, HEAD, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "*" },
        { "key": "Access-Control-Max-Age", "value": "86400" },
        { "key": "Vary", "value": "Origin" },
        { "key": "Cache-Control", "value": "public, max-age=604800, s-maxage=31536000, immutable" }
      ]
    },
    {
      "source": "/cdnjs/:path*",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, HEAD, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "*" },
        { "key": "Access-Control-Max-Age", "value": "86400" },
        { "key": "Vary", "value": "Origin" },
        { "key": "Cache-Control", "value": "public, max-age=604800, s-maxage=31536000, immutable" }
      ]
    },
    {
      "source": "/my/:path*",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, HEAD, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "*" },
        { "key": "Access-Control-Max-Age", "value": "86400" },
        { "key": "Vary", "value": "Origin" },
        { "key": "Cache-Control", "value": "public, max-age=604800, s-maxage=31536000, immutable" }
      ]
    },
    {
      "source": "/avatar/:path*",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, HEAD, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "*" },
        { "key": "Access-Control-Max-Age", "value": "86400" },
        { "key": "Vary", "value": "Origin" },
        { "key": "Cache-Control", "value": "public, max-age=1800, s-maxage=86400" }
      ]
    },
    {
      "source": "/(.*\\.js)",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript" }
      ]
    },
    {
      "source": "/(.*\\.mjs)",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript" }
      ]
    },
    {
      "source": "/(.*\\.css)",
      "headers": [
        { "key": "Content-Type", "value": "text/css" }
      ]
    },
    {
      "source": "/(.*\\.json)",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/(.*\\.map)",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/(.*\\.png)",
      "headers": [
        { "key": "Content-Type", "value": "image/png" }
      ]
    },
    {
      "source": "/(.*\\.jpg)",
      "headers": [
        { "key": "Content-Type", "value": "image/jpeg" }
      ]
    },
    {
      "source": "/(.*\\.jpeg)",
      "headers": [
        { "key": "Content-Type", "value": "image/jpeg" }
      ]
    },
    {
      "source": "/(.*\\.svg)",
      "headers": [
        { "key": "Content-Type", "value": "image/svg+xml" }
      ]
    },
    {
      "source": "/(.*\\.woff2)",
      "headers": [
        { "key": "Content-Type", "value": "font/woff2" }
      ]
    },
    {
      "source": "/(.*\\.woff)",
      "headers": [
        { "key": "Content-Type", "value": "font/woff" }
      ]
    },
    {
      "source": "/(.*\\.ttf)",
      "headers": [
        { "key": "Content-Type", "value": "font/ttf" }
      ]
    },
    {
      "source": "/(.*\\.wasm)",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/npm/:path*", "destination": "https://cdn.jsdelivr.net/npm/:path*" },
    { "source": "/gh/:path*", "destination": "https://cdn.jsdelivr.net/gh/:path*" },
    { "source": "/wp/:path*", "destination": "https://cdn.jsdelivr.net/wp/:path*" },
    { "source": "/cdnjs/:path*", "destination": "https://cdnjs.cloudflare.com/:path*" },
    { "source": "/my/:path*", "destination": "https://cdn.jsdelivr.net/gh/Brandon-LIs/:path*" },
    { "source": "/avatar/:path*", "destination": "https://gravatar.com/avatar/:path*" },
    { "source": "/((?!$).*)", "destination": "https://cdn.jsdelivr.net/gh/Brandon-LIs/blogimg@refs/heads/main/$1" }
  ]
}
